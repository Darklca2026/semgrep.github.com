# Copy these values to Codespaces secrets or a local .env file used by docker compose.
# Never commit real secrets.

GITHUB_OWNER=Darklca2026
GITHUB_TOKEN=github_pat_or_classic_pat_here

# n8n login for the forwarded port.
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-a-strong-password

# Must be stable. Use a long random value, at least 32 characters.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-32-character-key

# Optional: set after Codespaces gives you the public forwarded URL.
N8N_EDITOR_BASE_URL=https://your-5678-url.app.github.dev
N8N_WEBHOOK_URL=https://your-5678-url.app.github.dev/

# Review behavior.
REPO_REVIEW_MIN_SEVERITY=high
REPO_REVIEW_CREATE_ISSUES=false
